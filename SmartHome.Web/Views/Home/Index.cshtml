@model IEnumerable<SmartHome.Data.Entities.Device>

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold text-primary">Akıllı Ev Kontrol Paneli</h1>
    <p class="lead">Sistemdeki tüm cihazların anlık durumu aşağıdadır.</p>
</div>

<div class="container">
    
    <div class="row text-center mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-primary shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title opacity-75"><i class="bi bi-cpu"></i> Toplam Cihaz</h5>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalDevices</h2>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-success shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title opacity-75"><i class="bi bi-lightning-charge"></i> Açık Cihazlar</h5>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.ActiveDevices</h2>
                </div>
            </div>
        </div>
        
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-danger shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title opacity-75"><i class="bi bi-wifi-off"></i> Çevrimdışı</h5>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.OfflineDevices</h2>
                </div>
            </div>
        </div>
    </div>

    @foreach (var roomGroup in Model.GroupBy(d => d.RoomId))
    {
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0 fw-bold text-secondary">
                    <i class="bi bi-house-door"></i> Oda ID: @roomGroup.Key
                </h5>
                <div class="btn-group">
                    <form asp-action="BulkRoomAction" method="post" class="me-2">
                        <input type="hidden" name="roomId" value="@roomGroup.Key" />
                        <input type="hidden" name="status" value="true" />
                        <button type="submit" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-play-fill"></i> Tümünü Aç
                        </button>
                    </form>
                    <form asp-action="BulkRoomAction" method="post">
                        <input type="hidden" name="roomId" value="@roomGroup.Key" />
                        <input type="hidden" name="status" value="false" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-stop-fill"></i> Tümünü Kapat
                        </button>
                    </form>
                </div>
            </div>

            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-4">Cihaz Adı</th>
                            <th>Durum</th>
                            <th>Değer</th>
                            <th>Bağlantı</th>
                            <th class="text-end pe-4">Aç/Kapat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in roomGroup)
                        {
                            <tr>
                                <td class="ps-4 fw-medium"><strong>#@item.DeviceId</strong> - @item.DeviceName</td>
                                <td>
                                    @if (item.IsActive == true)
                                    {
                                        <span class="badge bg-success px-3 py-2">AÇIK</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2">KAPALI</span>
                                    }
                                </td>
                                <td>
                                    @if (item.CurrentValue != null)
                                    {
                                        <span class="fw-bold">@item.CurrentValue</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsOnline == true)
                                    {
                                        <span class="text-success fw-bold"><i class="bi bi-wifi"></i> Online</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold"><i class="bi bi-wifi-off"></i> Offline</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="ToggleDevice" method="post">
                                        <input type="hidden" name="id" value="@item.DeviceId" />
                                        @if (item.IsActive == true)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-power"></i> Kapat
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-power"></i> Aç
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>